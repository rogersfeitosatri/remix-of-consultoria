# Variáveis de build do frontend (Vite).
# Todas viram texto público dentro do bundle — nenhum segredo entra aqui.
# Segredos de servidor (service role, OPENAI, ASAAS, ZAPI, Google OAuth) ficam
# apenas nas secrets das Edge Functions do Supabase.
#
# No Vercel: Project Settings > Environment Variables, nos três ambientes
# (Production, Preview, Development).

# --- Supabase ---
VITE_SUPABASE_URL="https://SEU_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="chave-anon-publicavel"
VITE_SUPABASE_PROJECT_ID="SEU_REF"

# Lidos por scripts e ferramentas de linha de comando (não pelo bundle).
SUPABASE_URL="https://SEU_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="chave-anon-publicavel"

# --- Firebase Cloud Messaging (push do PWA) ---
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""
